---
interface Props {
  banner: {
    law: string;
    text: string;
  };
}

const { banner } = Astro.props;
---

<section class="philosophy-banner">
  <div class="container">
    <div class="banner__rule" aria-hidden="true"></div>
    <div class="banner__body">
      <p class="banner__law label">{banner.law}</p>
      <blockquote class="banner__quote">
        {banner.text}
      </blockquote>
    </div>
  </div>
</section>

<style>
  .philosophy-banner {
    padding-block: var(--space-xl);
  }

  .banner__rule {
    width: 100%;
    height: 1px;
    background: var(--c-rule);
    margin-bottom: var(--space-lg);
    transform-origin: left center;
  }

  .banner__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-left: clamp(0px, 8vw, 6rem);
  }

  .banner__law {
    color: var(--c-accent);
    letter-spacing: 0.18em;
  }

  .banner__quote {
    font-family: var(--f-serif);
    font-size: var(--fs-quote);
    font-weight: 300;
    font-style: italic;
    line-height: 1.25;
    color: var(--c-text);
    max-width: 22ch;
    quotes: none;
    letter-spacing: -0.01em;
  }
</style>
