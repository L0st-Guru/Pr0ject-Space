---
interface Props {
  banner: {
    law: string;
    text: string;
  };
}

const { banner } = Astro.props;
---

<section class="philosophy-banner">
  <div class="container">
    <div class="banner__rule" aria-hidden="true"></div>
    <div class="banner__body">
      <p class="banner__law">{banner.law}</p>
      <p class="banner__quote">{banner.text}</p>
    </div>
  </div>
</section>

<style>
  .philosophy-banner {
    padding-block: var(--space-xl);
  }

  .banner__rule {
    width: 100%;
    height: 1px;
    background: var(--c-rule);
    margin-bottom: var(--space-lg);
    transform-origin: left center;
  }

  .banner__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-left: clamp(0px, 8vw, 6rem);
  }

  .banner__law {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .banner__quote {
    font-family: var(--f-mono);
    font-size: clamp(0.95rem, 1.6vw, 1.25rem);
    font-weight: 400;
    font-style: normal;
    line-height: 1.55;
    color: var(--c-text);
    letter-spacing: 0.01em;
  }
</style>
