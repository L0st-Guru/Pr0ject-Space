---
import Layout from '../layouts/Layout.astro';
import { projects, philosophyBanners } from '../../projects.config.js';
---

<Layout>
  <div class="grain" aria-hidden="true"></div>
  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

  <nav class="site-nav" aria-label="Main navigation">
    <a href="#hero" class="nav__brand">PR0JECT: SPACE</a>
    <ul class="nav__links" role="list">
      <li><a href="#about" class="nav__link">About</a></li>
      <li><a href="#brands" class="nav__link">Brands</a></li>
      <li><a href="#philosophies" class="nav__link">Philosophies</a></li>
    </ul>
  </nav>

  <main>

    <!-- ── Hero ──────────────────────────────────────────────── -->
    <section class="hero" id="hero" aria-label="Introduction">
      <!--
        Diagonal right-side slice.
        Top: image starts at 10% from left (near full-width).
        Bottom: image starts at 48% from left (half-width).
        Left edge therefore runs "/" style from top-left inward —
        a clear ~26° diagonal across the full viewport height.
      -->
      <div class="hero__bg" aria-hidden="true">
        <img src="/images/Hermes%20delivery.png" alt="" width="900" height="1200" />
      </div>

      <div class="container hero__container">
        <div class="hero__copy">
          <h1 class="hero__headline" aria-label="I ran into problems. I looked to understand them properly. Then I built a fix.">
            <span class="hero__line"><span class="hero__line-inner">I ran into problems.</span></span>
            <span class="hero__line"><span class="hero__line-inner">I looked to understand</span></span>
            <span class="hero__line"><span class="hero__line-inner">them properly.</span></span>
            <span class="hero__line hero__line--punch"><span class="hero__line-inner">Then I built a fix.</span></span>
          </h1>
          <p class="hero__tagline">
            I built this to help me,&nbsp;perhaps it can help you.
          </p>
        </div>

        <div class="hero__scroll" aria-hidden="true">
          <span class="label">scroll</span>
          <div class="hero__scroll-track">
            <div class="hero__scroll-thumb"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Philosophy ─────────────────────────────────────────── -->
    <section class="philosophy-section" id="philosophies" aria-label="Philosophies">
      <div class="container">
        <p class="philosophy-intro">The method. These are the principles we build with.</p>
        <div class="philosophy-grid">
          {philosophyBanners.map((banner) => (
            <div class="philosophy-cell">
              <p class="philosophy-cell__law">{banner.law}</p>
              <p class="philosophy-cell__quote">{banner.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Diagonal slice: Coeus ──────────────────────────────── -->
    <!--
      Full-width parallelogram band at ~6° from horizontal.
      10.5vw ≈ tan(6°) × 100vw — angle stays correct at any width.
    -->
    <div class="img-slice" aria-hidden="true">
      <div class="img-slice__inner">
        <img src="/images/Coeus%20writing.png" alt="" width="1600" height="900" />
      </div>
    </div>

    <!-- ── Products ───────────────────────────────────────────── -->
    <section class="products" id="brands" aria-label="Products">
      <div class="container">
        <div class="products__grid">

          {projects.map((project, i) => (
            <article
              class={`product-card${project.image ? ' product-card--img' : ''}`}
              id={project.id}
            >
              {project.image && (
                <div class="product-card__bg" aria-hidden="true">
                  <img src={project.image} alt="" width="600" height="800" />
                </div>
              )}

              <div class="product-card__header">
                <span class="product-card__num">0{i + 1}</span>
                <span class={`card-status card-status--${project.status}`}>
                  {project.status}
                </span>
              </div>

              <div class="product-card__body">
                <h2 class="product-card__name">{project.name}</h2>
                {project.tagline && (
                  <p class="product-card__tagline">{project.tagline}</p>
                )}
                {project.url && (
                  <a
                    href={project.url}
                    class="product-card__link"
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    {project.url.replace('https://', '')} ↗
                  </a>
                )}
              </div>
            </article>
          ))}

        </div>
      </div>
    </section>

  </main>

  <footer class="site-footer" id="about">
    <div class="container">
      <span class="label">© {new Date().getFullYear()} Pr0ject: Space</span>
      <span class="label">pr0ject.space</span>
    </div>
  </footer>

</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // ── Scroll progress ──────────────────────────────────────
  const progressBar = document.getElementById('scroll-progress');
  if (progressBar) {
    ScrollTrigger.create({
      start: 0,
      end: 'max',
      onUpdate: (self) => {
        progressBar.style.width = `${self.progress * 100}%`;
      },
    });
  }

  // ── Hero: lines clip upward ──────────────────────────────
  const heroTl = gsap.timeline({ delay: 0.25 });
  heroTl
    .from('.hero__line-inner', {
      y: '115%',
      duration: 1.15,
      stagger: 0.09,
      ease: 'power4.out',
    })
    .from('.hero__tagline',
      { opacity: 0, y: 18, duration: 0.9, ease: 'power3.out' },
      '-=0.55',
    )
    .from('.hero__scroll',
      { opacity: 0, y: 12, duration: 0.7, ease: 'power3.out' },
      '-=0.5',
    );

  // ── Hero image fade + scale in ───────────────────────────
  gsap.from('.hero__bg img', {
    opacity: 0,
    scale: 1.04,
    duration: 1.8,
    delay: 0.2,
    ease: 'power3.out',
  });

  // ── Scroll thumb loop ────────────────────────────────────
  gsap.fromTo('.hero__scroll-thumb',
    { y: '-100%' },
    { y: '200%', duration: 1.8, ease: 'power2.inOut', repeat: -1, repeatDelay: 0.4 },
  );

  // ── Philosophy: intro + grid cells ──────────────────────
  gsap.from('.philosophy-intro', {
    opacity: 0, y: 10, duration: 0.6, ease: 'power3.out',
    scrollTrigger: { trigger: '.philosophy-section', start: 'top 80%', toggleActions: 'play none none none' },
  });

  gsap.from('.philosophy-cell', {
    opacity: 0, y: 20, duration: 0.75, stagger: 0.12, ease: 'power3.out',
    scrollTrigger: { trigger: '.philosophy-grid', start: 'top 75%', toggleActions: 'play none none none' },
  });

  // ── Product cards ────────────────────────────────────────
  document.querySelectorAll('.product-card').forEach((card, i) => {
    gsap.from(card, {
      opacity: 0, y: 30, duration: 0.85,
      delay: (i % 3) * 0.1,
      ease: 'power3.out',
      scrollTrigger: { trigger: card, start: 'top 88%', toggleActions: 'play none none none' },
    });
  });
</script>

<style>
  /* ── Hero ────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    padding-top: var(--nav-h);
    padding-bottom: clamp(4rem, 8vw, var(--space-xl));
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    clip-path: polygon(10% 0%, 100% 0%, 100% 100%, 48% 100%);
    overflow: hidden;
  }

  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% 20%;
  }

  .hero__container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* Text stays in the bottom-left clear zone (below the diagonal) */
  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: clamp(280px, 46%, 700px);
  }

  /* Hero headline: only place Cormorant italic is used */
  .hero__headline {
    font-family: var(--f-serif);
    font-size: var(--fs-display);
    font-style: italic;
    font-weight: 300;
    display: flex;
    flex-direction: column;
    gap: 0.06em;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    line-height: 1.08;
    padding-bottom: 0.06em;
  }

  .hero__line-inner { display: block; }

  .hero__line--punch .hero__line-inner {
    color: var(--c-accent);
  }

  .hero__tagline {
    font-family: var(--f-mono);
    font-size: var(--fs-tagline);
    font-style: normal;
    color: var(--c-muted);
    max-width: 44ch;
    line-height: var(--lh-loose);
  }

  .hero__scroll {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .hero__scroll-track {
    width: 1px;
    height: 56px;
    background: var(--c-border);
    overflow: hidden;
    position: relative;
  }

  .hero__scroll-thumb {
    position: absolute;
    inset: 0 auto auto 0;
    width: 1px;
    height: 50%;
    background: linear-gradient(to bottom, transparent, var(--c-accent));
  }

  /* ── Philosophy ─────────────────────────────────────── */
  .philosophy-section {
    padding-block: var(--space-lg);  /* 4rem — 50% of original 8rem */
  }

  .philosophy-intro {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    font-style: normal;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-muted);
    margin-bottom: var(--space-md);
  }

  .philosophy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-border);
    border: 1px solid var(--c-border);
  }

  .philosophy-cell {
    background: var(--c-bg);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .philosophy-cell__law {
    font-family: var(--f-mono);
    font-size: 0.68rem;
    font-style: normal;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-accent);
    line-height: 1.4;
  }

  .philosophy-cell__quote {
    font-family: var(--f-mono);
    font-size: 0.85rem;
    font-style: normal;
    font-weight: 400;
    color: var(--c-text);
    line-height: 1.6;
    letter-spacing: 0.01em;
  }

  /* ── Diagonal image slice ───────────────────────────── */
  .img-slice {
    position: relative;
    height: clamp(300px, 40vh, 500px);
    overflow: hidden;
  }

  .img-slice__inner {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: polygon(0 10.5vw, 100% 0%, 100% calc(100% - 10.5vw), 0% 100%);
  }

  .img-slice__inner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  /* ── Products ───────────────────────────────────────── */
  .products {
    padding-block: var(--space-xl);
  }

  .products__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-border);
    border: 1px solid var(--c-border);
  }

  .product-card {
    position: relative;
    padding: var(--space-lg);
    background: var(--c-bg);
    min-height: 400px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: background 0.3s var(--ease-smooth);
  }

  .product-card:hover { background: #111820; }

  .product-card__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .product-card__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    opacity: 0.3;
    mix-blend-mode: luminosity;
  }

  .product-card__header {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-shrink: 0;
  }

  .product-card__num {
    font-family: var(--f-mono);
    font-size: 0.62rem;
    font-style: normal;
    letter-spacing: 0.12em;
    color: var(--c-dim);
  }

  .card-status {
    font-family: var(--f-mono);
    font-size: 0.58rem;
    font-style: normal;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .card-status--soon     { color: var(--c-accent); }
  .card-status--live     { color: var(--c-text); }
  .card-status--beta     { color: var(--c-muted); }
  .card-status--building { color: var(--c-muted); }

  .product-card__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: auto;
    padding-top: var(--space-xl);
  }

  .product-card__name {
    font-family: var(--f-mono);
    font-size: clamp(1rem, 2vw, 1.45rem);
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--c-text);
    line-height: 1.1;
  }

  .product-card__tagline {
    font-family: var(--f-mono);
    font-size: 0.78rem;
    font-style: normal;
    font-weight: 400;
    color: var(--c-text);
    line-height: 1.65;
    letter-spacing: 0.02em;
  }

  .product-card__link {
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    font-style: normal;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-accent);
    text-decoration: none;
    transition: color 0.2s var(--ease-smooth);
    margin-top: var(--space-xs);
  }

  .product-card__link:hover { color: var(--c-text); }

  /* ── Responsive ─────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero__bg {
      clip-path: none;
      opacity: 0.3;
    }
    .hero__copy { max-width: 100%; }
    .philosophy-grid { grid-template-columns: 1fr; }
    .products__grid  { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 540px) {
    .products__grid { grid-template-columns: 1fr; }
  }
</style>
