---
import Layout from '../layouts/Layout.astro';
import PhilosophyBanner from '../components/PhilosophyBanner.astro';
import { projects, philosophyBanners } from '../../projects.config.js';
---

<Layout>
  <!-- Grain overlay -->
  <div class="grain" aria-hidden="true"></div>

  <!-- Scroll progress bar -->
  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

  <!-- Fixed nav -->
  <nav class="site-nav" aria-label="Main navigation">
    <a href="#hero" class="nav__brand">PR0JECT: SPACE</a>
    <ul class="nav__links" role="list">
      <li><a href="#about" class="nav__link">About</a></li>
      <li><a href="#brands" class="nav__link">Brands</a></li>
      <li><a href="#philosophies" class="nav__link">Philosophies</a></li>
    </ul>
  </nav>

  <main>

    <!-- ── Hero ──────────────────────────────────────────────── -->
    <section class="hero" id="hero" aria-label="Introduction">

      <!-- Hermes image: diagonal slice from right -->
      <div class="hero__bg" aria-hidden="true">
        <img
          src="/images/Hermes_delivery.png"
          alt=""
          width="900"
          height="1200"
        />
      </div>

      <!-- Left-to-right gradient keeps text readable -->
      <div class="hero__overlay" aria-hidden="true"></div>

      <div class="container hero__container">
        <div class="hero__copy">

          <h1 class="hero__headline" aria-label="I ran into problems. I looked to understand them properly. Then I built a fix.">
            <span class="hero__line"><span class="hero__line-inner">I ran into problems.</span></span>
            <span class="hero__line"><span class="hero__line-inner">I looked to understand</span></span>
            <span class="hero__line"><span class="hero__line-inner">them properly.</span></span>
            <span class="hero__line hero__line--punch"><span class="hero__line-inner">Then I built a fix.</span></span>
          </h1>

          <p class="hero__tagline">
            I built this to help me,&nbsp;perhaps it can help you.
          </p>

        </div>

        <div class="hero__scroll" aria-hidden="true">
          <span class="label">scroll</span>
          <div class="hero__scroll-track">
            <div class="hero__scroll-thumb"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Philosophy ─────────────────────────────────────────── -->
    <section id="philosophies" aria-label="Philosophies">
      {philosophyBanners.map((banner) => (
        <PhilosophyBanner banner={banner} />
      ))}
    </section>

    <!-- ── Diagonal slice: Coeus ──────────────────────────────── -->
    <div class="img-slice" aria-hidden="true">
      <div class="img-slice__inner">
        <img
          src="/images/Coeus_writing.png"
          alt=""
          width="1600"
          height="900"
        />
      </div>
    </div>

    <!-- ── Products ───────────────────────────────────────────── -->
    <section class="products" id="brands" aria-label="Products">
      <div class="container">
        <div class="products__grid">

          {projects.map((project, i) => (
            <article
              class={`product-card${project.image ? ' product-card--img' : ''}`}
              id={project.id}
            >
              {project.image && (
                <div class="product-card__bg" aria-hidden="true">
                  <img
                    src={project.image}
                    alt=""
                    width="600"
                    height="800"
                  />
                </div>
              )}

              <div class="product-card__header">
                <span class="product-card__num">0{i + 1}</span>
                <span class={`card-status card-status--${project.status}`}>
                  {project.status}
                </span>
              </div>

              <div class="product-card__body">
                <h2 class="product-card__name">{project.name}</h2>
                {project.tagline && (
                  <p class="product-card__tagline">{project.tagline}</p>
                )}
                {project.url && (
                  <a
                    href={project.url}
                    class="product-card__link"
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    {project.url.replace('https://', '')} ↗
                  </a>
                )}
              </div>
            </article>
          ))}

        </div>
      </div>
    </section>

  </main>

  <!-- ── Footer ─────────────────────────────────────────────── -->
  <footer class="site-footer" id="about">
    <div class="container">
      <span class="label">© {new Date().getFullYear()} Pr0ject: Space</span>
      <span class="label">pr0ject.space</span>
    </div>
  </footer>

</Layout>

<!-- ── Animations ──────────────────────────────────────────── -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // ── Scroll progress bar ─────────────────────────────────
  const progressBar = document.getElementById('scroll-progress');
  if (progressBar) {
    ScrollTrigger.create({
      start: 0,
      end: 'max',
      onUpdate: (self) => {
        progressBar.style.width = `${self.progress * 100}%`;
      },
    });
  }

  // ── Hero entrance ────────────────────────────────────────
  const heroTl = gsap.timeline({ delay: 0.25 });

  heroTl
    .from('.hero__line-inner', {
      y: '115%',
      duration: 1.15,
      stagger: 0.09,
      ease: 'power4.out',
    })
    .from(
      '.hero__tagline',
      { opacity: 0, y: 18, duration: 0.9, ease: 'power3.out' },
      '-=0.55',
    )
    .from(
      '.hero__scroll',
      { opacity: 0, y: 12, duration: 0.7, ease: 'power3.out' },
      '-=0.5',
    );

  // ── Hero image fade in ───────────────────────────────────
  gsap.from('.hero__bg img', {
    opacity: 0,
    scale: 1.04,
    duration: 1.8,
    delay: 0.15,
    ease: 'power3.out',
  });

  // ── Scroll thumb (infinite loop) ────────────────────────
  gsap.fromTo(
    '.hero__scroll-thumb',
    { y: '-100%' },
    { y: '200%', duration: 1.8, ease: 'power2.inOut', repeat: -1, repeatDelay: 0.4 },
  );

  // ── Philosophy banners ───────────────────────────────────
  document.querySelectorAll('.philosophy-banner').forEach((banner) => {
    const rule  = banner.querySelector('.banner__rule');
    const law   = banner.querySelector('.banner__law');
    const quote = banner.querySelector('.banner__quote');

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: banner,
        start: 'top 68%',
        toggleActions: 'play none none none',
      },
    });

    tl.fromTo(rule,
      { scaleX: 0 },
      { scaleX: 1, duration: 1, ease: 'power3.inOut' },
    );
    tl.from(law,
      { opacity: 0, y: 8, duration: 0.65, ease: 'power3.out' },
      '-=0.35',
    );
    tl.from(quote,
      { opacity: 0, y: 44, duration: 1.2, ease: 'power3.out' },
      '-=0.4',
    );
  });

  // ── Diagonal slice: parallax + reveal ───────────────────
  document.querySelectorAll('.img-slice').forEach((slice) => {
    const inner = slice.querySelector<HTMLElement>('.img-slice__inner');
    const img   = slice.querySelector<HTMLElement>('img');

    if (inner) {
      gsap.from(inner, {
        opacity: 0,
        duration: 1.3,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: slice,
          start: 'top 82%',
          toggleActions: 'play none none none',
        },
      });
    }

    if (img) {
      gsap.fromTo(img,
        { yPercent: -7 },
        {
          yPercent: 7,
          ease: 'none',
          scrollTrigger: {
            trigger: slice,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          },
        },
      );
    }
  });

  // ── Product cards staggered reveal ──────────────────────
  document.querySelectorAll('.product-card').forEach((card, i) => {
    gsap.from(card, {
      opacity: 0,
      y: 30,
      duration: 0.85,
      delay: (i % 3) * 0.1,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: card,
        start: 'top 88%',
        toggleActions: 'play none none none',
      },
    });
  });
</script>

<style>
  /* ── Hero ────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    padding-top: var(--nav-h);
    padding-bottom: clamp(4rem, 8vw, var(--space-xl));
    overflow: hidden;
  }

  /* Hermes image — right-side diagonal slice */
  .hero__bg {
    position: absolute;
    top: 0;
    right: 0;
    width: 62%;
    height: 100%;
    z-index: 0;
    clip-path: polygon(14% 0, 100% 0, 100% 100%, 0 100%);
    overflow: hidden;
  }

  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    opacity: 0.42;
  }

  /* Left-to-right fade — protects headline legibility */
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      100deg,
      rgba(15, 15, 15, 1)    0%,
      rgba(15, 15, 15, 0.96) 38%,
      rgba(15, 15, 15, 0.55) 62%,
      rgba(15, 15, 15, 0.12) 100%
    );
    pointer-events: none;
  }

  .hero__container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .hero__headline {
    font-size: var(--fs-display);
    font-style: italic;
    font-weight: 300;
    display: flex;
    flex-direction: column;
    gap: 0.06em;
  }

  /* Clip wrapper: overflow hidden masks the upward enter */
  .hero__line {
    display: block;
    overflow: hidden;
    line-height: 1.08;
    padding-bottom: 0.06em;
  }

  .hero__line-inner {
    display: block;
  }

  .hero__line--punch .hero__line-inner {
    color: var(--c-accent);
  }

  .hero__tagline {
    font-family: var(--f-mono);
    font-size: var(--fs-tagline);
    color: var(--c-muted);
    max-width: 52ch;
    line-height: var(--lh-loose);
  }

  /* Scroll indicator */
  .hero__scroll {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .hero__scroll-track {
    width: 1px;
    height: 56px;
    background: var(--c-border);
    overflow: hidden;
    position: relative;
  }

  .hero__scroll-thumb {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 50%;
    background: linear-gradient(to bottom, transparent, var(--c-accent));
  }

  /* ── Diagonal image slice ──────────────────────────── */
  .img-slice {
    position: relative;
    width: 100%;
    height: clamp(280px, 44vh, 560px);
    pointer-events: none;
  }

  .img-slice__inner {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* parallelogram cut: ~5° angle at typical viewport widths */
    clip-path: polygon(0 9%, 100% 0%, 100% 91%, 0% 100%);
  }

  .img-slice__inner img {
    width: 100%;
    height: 120%;       /* extra height consumed by parallax */
    margin-top: -10%;   /* centre the starting frame */
    object-fit: cover;
    object-position: center center;
  }

  /* ── Products grid ─────────────────────────────────── */
  .products {
    padding-block: var(--space-xl);
  }

  /* Gap lines achieved by setting bg on the grid itself */
  .products__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--c-border);
    border: 1px solid var(--c-border);
  }

  .product-card {
    position: relative;
    padding: var(--space-lg);
    background: var(--c-bg);
    min-height: 400px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: background 0.3s var(--ease-smooth);
  }

  .product-card:hover {
    background: #141414;
  }

  /* Janus background image at low opacity */
  .product-card__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .product-card__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    opacity: 0.1;
    mix-blend-mode: luminosity;
  }

  .product-card__header {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-shrink: 0;
  }

  .product-card__num {
    font-family: var(--f-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--c-dim);
  }

  .card-status {
    font-family: var(--f-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .card-status--soon     { color: var(--c-accent); }
  .card-status--live     { color: var(--c-text); }
  .card-status--beta     { color: var(--c-muted); }
  .card-status--building { color: var(--c-muted); }

  .product-card__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: auto;
    padding-top: var(--space-xl);
  }

  .product-card__name {
    font-family: var(--f-mono);
    font-size: clamp(1rem, 2vw, 1.45rem);
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--c-text);
    line-height: 1.1;
  }

  .product-card__tagline {
    font-family: var(--f-serif);
    font-size: var(--fs-body);
    font-style: italic;
    color: var(--c-muted);
    line-height: var(--lh-loose);
  }

  .product-card__link {
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-accent);
    text-decoration: none;
    transition: color 0.2s var(--ease-smooth);
    margin-top: var(--space-xs);
  }

  .product-card__link:hover {
    color: var(--c-text);
  }

  /* ── Responsive ─────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero__bg {
      width: 100%;
      clip-path: none;
    }

    .hero__overlay {
      background: linear-gradient(
        180deg,
        rgba(15, 15, 15, 0.55) 0%,
        rgba(15, 15, 15, 0.88) 55%,
        rgba(15, 15, 15, 1)   100%
      );
    }

    .products__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .products__grid {
      grid-template-columns: 1fr;
    }

    .nav__links {
      gap: var(--space-sm);
    }
  }
</style>
