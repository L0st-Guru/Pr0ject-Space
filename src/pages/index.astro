---
import Layout from '../layouts/Layout.astro';
import { projects, philosophyBanners } from '../../projects.config.js';
---

<Layout>
  <div class="grain" aria-hidden="true"></div>
  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

  <!-- Custom cursor -->
  <div class="cursor-ring" id="cursorRing"></div>
  <div class="cursor-dot" id="cursorDot"></div>

  <!-- NAV -->
  <nav class="site-nav" id="nav" aria-label="Primary">
    <a href="#top" class="nav__brand" data-cursor="hover">
      <span class="nav__pulse" aria-hidden="true"></span>
      <span>PR0JECT: SPACE</span>
    </a>
    <div class="nav__links">
      <a href="#about" class="nav__link" data-cursor="hover">About</a>
      <a href="#brands" class="nav__link" data-cursor="hover">Brands</a>
      <a href="#philosophies" class="nav__link" data-cursor="hover">Philosophies</a>
    </div>
  </nav>

  <!-- HERO -->
  <header class="hero" id="top">
    <div class="hero__meta open">
      <span class="hero__meta-pill">Index · 2026 / Q2</span>
      <span>Lon — 51.5074° N · 0.1278° W</span>
      <span>v0.4.2</span>
    </div>

    <h1 class="hero__headline">
      <span class="open open--2">i ran into</span><br>
      <span class="open open--2">problems<span class="c-accent">.</span></span><br>
      <span class="open open--3">i looked to</span><br>
      <span class="open open--3"><span class="c-accent">understand</span> them</span><br>
      <span class="open open--3">PROPERLY,</span><br>
      <span class="open open--3">then built a fix<span class="c-accent">.</span></span>
    </h1>

    <p class="hero__sub open open--4">
      <b>Tools built from practice.</b> Not theory.
    </p>

    <div class="hero__footer open open--4">
      <span class="scroll-cue">
        <span class="scroll-cue__line"></span>
        <span>Scroll · Index</span>
      </span>
      <span>Four products · One practitioner · No theatre</span>
    </div>
  </header>

  <!-- SLICE 01: Hermes -->
  <section class="slice" aria-label="Hermes — delivery">
    <div class="slice__media" data-parallax="0.08">
      <img src="/images/Hermes%20delivery.png" alt="" width="1600" height="900" />
    </div>
    <div class="slice__noise" aria-hidden="true"></div>
    <div class="slice__caption">
      <span class="slice__idx">FIG. 01</span>
      <span class="slice__bar"></span>
      <span>Hermes — Delivery in progress</span>
    </div>
  </section>

  <!-- PHILOSOPHIES -->
  <section class="philosophies" id="philosophies">
    <div class="section-label reveal">
      <span class="section-label__num">§ 02</span>
      <span>THE BUILDING BLOCKS</span>
      <span class="section-label__rule"></span>
      <span>Read top to bottom</span>
    </div>

    {philosophyBanners.map((banner) => (
      <article class="law reveal-l">
        <div class="law__num">
          <b>{banner.num}</b>{banner.numLabel}
        </div>
        <div>
          <h2 class="law__title">
            {banner.law.split(' ').map((word, i, arr) => (
              <>
                {word}{i < arr.length - 1 ? <br /> : null}
              </>
            ))}
          </h2>
          <p class="law__body">
            <em>{banner.text}</em>
          </p>
          <div class="law__meta">
            <span>Discipline · <b>{banner.discipline}</b></span>
            <span>Form · <b>{banner.form}</b></span>
            <span>Cited in · <b>{banner.citedIn}</b></span>
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- SLICE 02: Coeus -->
  <section class="slice slice--alt" aria-label="Coeus — writing">
    <div class="slice__media" data-parallax="0.08">
      <img src="/images/Coeus%20writing.png" alt="" width="1600" height="900" />
    </div>
    <div class="slice__noise" aria-hidden="true"></div>
    <div class="slice__caption">
      <span>Coeus — Notes from the layer above</span>
      <span class="slice__bar"></span>
      <span class="slice__idx">FIG. 02</span>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="products" id="brands">
    <div class="products__head reveal">
      <h2 class="products__title">THE TOOLS<br><span class="products__amp">&amp;</span> WHAT THEY DO</h2>
      <div class="products__sub">
        § 03 · Four products<br>One coherent practice
      </div>
    </div>

    <div class="product-grid stagger">
      {projects.map((project) => (
        <a
          class:list={[
            'card',
            !project.isLive && 'card--soon',
            project.image && 'card--img',
          ]}
          href={project.url || undefined}
          data-cursor="hover"
        >
          {project.image && (
            <div class="card__bg" aria-hidden="true">
              <img src={project.image} alt="" width="600" height="800" />
            </div>
          )}

          <div class="card__head">
            <span class="card__num">{project.num} / {project.displayId}</span>
            <span class:list={['card__status', project.isLive && 'is-live']}>
              {project.statusLabel}
            </span>
          </div>

          <div class="card__body">
            <h3 class="card__name">{project.name}</h3>
            {project.problem && project.solution ? (
              <>
                <p class="card__problem"><b>Problem ·</b> {project.problem}</p>
                <p class="card__solution"><b>Solution ·</b> {project.solution}</p>
              </>
            ) : project.tagline ? (
              <p class="card__tag">{project.tagline}</p>
            ) : (
              <p class="card__tag"><em>TBC.</em></p>
            )}
          </div>

          <div class="card__foot">
            <span>{project.urlLabel}</span>
            <span class="card__arrow">{project.url ? '↗' : '·'}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about" id="about">
    <aside class="about__label reveal">
      <div><b>§ 04</b></div>
      <div>ABOUT THE ME</div>
      <div>Direct, first-person,<br>no marketing language.</div>
    </aside>
    <div class="about__body reveal">
      <p>I've worked in Cybersecurity for 15 years, so naturally, I became <em>the&nbsp;guy</em>. These are some of the tools that I have been building, and perhaps they will work for you, too. Fun!</p>
      <div class="about__sig">
        <span class="about__sig-dash"></span>
        <span>ME · LONDON · 2026</span>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="foot">
    <div class="foot__col">
      <span>© Pr0ject: Space · 2026</span>
      <span>Built in terminals</span>
    </div>
    <div class="foot__col">
      <a href="#top" data-cursor="hover">Index</a>
      <a href="#about" data-cursor="hover">About</a>
      <a href="#brands" data-cursor="hover">Brands</a>
      <a href="mailto:hello@pr0ject.space" data-cursor="hover">hello@pr0ject.space</a>
    </div>
  </footer>

</Layout>

<script>
  /* ── Scroll progress ── */
  (function () {
    const bar = document.getElementById('scroll-progress');
    if (!bar) return;
    function update() {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.width = max > 0 ? `${(window.scrollY / max) * 100}%` : '0%';
    }
    window.addEventListener('scroll', update, { passive: true });
    update();
  })();

  /* ── Nav scroll state ── */
  (function () {
    const nav = document.getElementById('nav');
    if (!nav) return;
    const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 40);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();

  /* ── Custom cursor ── */
  (function () {
    const dot = document.getElementById('cursorDot');
    const ring = document.getElementById('cursorRing');
    if (!dot || !ring) return;
    let mx = -100, my = -100, rx = -100, ry = -100;
    window.addEventListener('mousemove', (e) => {
      mx = e.clientX; my = e.clientY;
      dot.style.transform = `translate3d(${mx - 3}px, ${my - 3}px, 0)`;
    });
    function loop() {
      rx += (mx - rx) * 0.18;
      ry += (my - ry) * 0.18;
      ring.style.transform = `translate3d(${rx - 17}px, ${ry - 17}px, 0)`;
      requestAnimationFrame(loop);
    }
    loop();
    document.querySelectorAll('[data-cursor="hover"]').forEach((el) => {
      el.addEventListener('mouseenter', () => ring.classList.add('is-hover'));
      el.addEventListener('mouseleave', () => ring.classList.remove('is-hover'));
    });
  })();

  /* ── Reveal on intersect ── */
  (function () {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.18, rootMargin: '0px 0px -8% 0px' }
    );
    document.querySelectorAll('.reveal, .reveal-l, .stagger').forEach((el) =>
      io.observe(el)
    );
  })();

  /* ── Parallax slice media ── */
  (function () {
    const els = document.querySelectorAll('[data-parallax]');
    if (!els.length) return;
    const onScroll = () => {
      const vh = window.innerHeight;
      els.forEach((el) => {
        const rect = el.getBoundingClientRect();
        const center = rect.top + rect.height / 2;
        const dist = (center - vh / 2) / vh;
        const amt = parseFloat((el as HTMLElement).dataset.parallax ?? '0.1');
        (el as HTMLElement).style.transform =
          `translate3d(0, ${dist * amt * 100}px, 0) scale(${1.04 - Math.min(0.04, Math.abs(dist) * 0.03)})`;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

<style>
  /* ── Hero ──────────────────────────────────────────────── */
  .hero {
    min-height: 100vh;
    display: grid;
    align-content: end;
    padding: 120px var(--gutter) 80px;
    position: relative;
    isolation: isolate;
  }

  .hero__meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    color: var(--c-muted);
    font-size: 11px;
    letter-spacing: .3em;
    text-transform: uppercase;
    border-top: 1px solid var(--c-border);
    padding-top: 18px;
    margin-bottom: clamp(60px, 12vw, 140px);
  }

  .hero__meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--c-text);
  }

  .hero__meta-pill::before {
    content: "";
    width: 6px;
    height: 6px;
    background: var(--c-accent);
    box-shadow: 0 0 10px var(--c-accent);
  }

  .hero__headline {
    margin: 0;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(2.2rem, 7.4vw, 6.2rem);
    line-height: 1.02;
    letter-spacing: -.01em;
    max-width: 18ch;
  }

  .c-accent { color: var(--c-accent); }

  .hero__sub {
    margin-top: 36px;
    color: var(--c-muted);
    font-size: 13px;
    letter-spacing: .28em;
    text-transform: uppercase;
    max-width: 60ch;
  }

  .hero__sub b {
    color: var(--c-text);
    font-weight: 400;
  }

  .hero__footer {
    margin-top: clamp(60px, 10vw, 120px);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
    font-size: 11px;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--c-text);
  }

  .scroll-cue__line {
    width: 60px;
    height: 1px;
    background: var(--c-text);
    transform-origin: left;
    animation: line-pulse 2.4s ease-in-out infinite;
  }

  @keyframes line-pulse {
    0%, 100% { transform: scaleX(.3); }
    50%       { transform: scaleX(1); }
  }

  /* ── Hero entrance animations ── */
  .open {
    opacity: 0;
    transform: translateY(28px);
    animation: open 1.1s .15s ease forwards;
  }

  .open--2 { animation-delay: .55s; }
  .open--3 { animation-delay: .85s; }
  .open--4 { animation-delay: 1.05s; }

  @keyframes open { to { opacity: 1; transform: none; } }

  @media (prefers-reduced-motion: reduce) {
    .open { animation: none; opacity: 1; transform: none; }
  }

  /* ── Diagonal slices ───────────────────────────────────── */
  .slice {
    position: relative;
    margin: clamp(60px, 9vw, 120px) 0;
    clip-path: polygon(0 6%, 100% 0, 100% 94%, 0 100%);
    background: #070b18;
    overflow: hidden;
    height: clamp(360px, 60vh, 620px);
  }

  .slice--alt {
    clip-path: polygon(0 0, 100% 6%, 100% 100%, 0 94%);
  }

  .slice__media {
    position: absolute;
    inset: -10% 0;
    will-change: transform;
  }

  .slice__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .slice__noise {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, .025) 0 1px,
      transparent 1px 3px
    );
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .slice__caption {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(28px, 6vw, 60px);
    display: flex;
    align-items: center;
    gap: 18px;
    font-size: 11px;
    letter-spacing: .32em;
    text-transform: uppercase;
    color: rgba(240, 237, 230, .7);
    z-index: 2;
    pointer-events: none;
  }

  .slice--alt .slice__caption {
    left: auto;
    right: var(--gutter);
  }

  .slice__idx {
    font-weight: 700;
    color: var(--c-accent);
  }

  .slice__bar {
    width: 42px;
    height: 1px;
    background: rgba(240, 237, 230, .4);
  }

  /* ── Philosophies ──────────────────────────────────────── */
  .philosophies {
    padding: clamp(40px, 6vw, 80px) 0;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0 var(--gutter);
    margin-bottom: clamp(40px, 6vw, 80px);
    font-size: 11px;
    letter-spacing: .32em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .section-label__num {
    color: var(--c-accent);
    font-weight: 700;
  }

  .section-label__rule {
    flex: 1;
    height: 1px;
    background: var(--c-border);
  }

  .law {
    padding: clamp(60px, 10vw, 130px) var(--gutter);
    border-top: 1px solid var(--c-border);
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: clamp(20px, 4vw, 60px);
    align-items: start;
  }

  .law:last-of-type {
    border-bottom: 1px solid var(--c-border);
  }

  .law__num {
    font-size: 12px;
    letter-spacing: .32em;
    text-transform: uppercase;
    color: var(--c-muted);
    padding-top: 10px;
    position: sticky;
    top: 120px;
  }

  .law__num b {
    color: var(--c-accent);
    font-weight: 700;
    display: block;
    font-size: 24px;
    letter-spacing: .04em;
    margin-bottom: 4px;
  }

  .law__title {
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 3.6vw, 2.6rem);
    color: var(--c-accent);
    margin: 0 0 24px;
    letter-spacing: .02em;
    line-height: 1.1;
  }

  .law__body {
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    color: var(--c-text);
    max-width: 56ch;
    line-height: 1.55;
    margin: 0;
  }

  .law__body em {
    font-style: italic;
    color: var(--c-muted);
  }

  .law__meta {
    margin-top: 28px;
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    font-size: 11px;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .law__meta span b {
    color: var(--c-text);
    font-weight: 400;
  }

  /* ── Products ──────────────────────────────────────────── */
  .products {
    padding: clamp(60px, 9vw, 120px) var(--gutter) clamp(40px, 6vw, 80px);
  }

  .products__head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: end;
    margin-bottom: clamp(40px, 6vw, 70px);
  }

  .products__title {
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 4.2vw, 3rem);
    margin: 0;
    letter-spacing: -.005em;
    line-height: 1.1;
  }

  .products__amp {
    color: var(--c-accent);
    font-style: italic;
    font-weight: 400;
  }

  .products__sub {
    color: var(--c-muted);
    font-size: 11px;
    letter-spacing: .3em;
    text-transform: uppercase;
    text-align: right;
    line-height: 1.6;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--c-border);
    border: 1px solid var(--c-border);
  }

  .card {
    position: relative;
    background: var(--c-bg);
    padding: clamp(28px, 4vw, 48px);
    min-height: 320px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 20px;
    overflow: hidden;
    isolation: isolate;
    transition: background-color .35s ease;
  }

  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 60%, rgba(255, 253, 35, 0) 100%);
    transition: background .4s ease;
    z-index: -1;
  }

  .card:hover { background: #141414; }

  .card:hover::before {
    background: linear-gradient(135deg, transparent 50%, rgba(255, 253, 35, .05) 100%);
  }

  .card:hover .card__arrow { transform: translate(4px, -4px); color: var(--c-accent); }
  .card:hover .card__name  { color: var(--c-accent); }

  .card__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    font-size: 11px;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .card__status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .card__status::before {
    content: "";
    width: 6px;
    height: 6px;
    background: currentColor;
    border-radius: 50%;
  }

  .card__status.is-live { color: var(--c-accent); }
  .card__status.is-live::before { box-shadow: 0 0 10px var(--c-accent); }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .card__name {
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    margin: 0;
    letter-spacing: -.005em;
    line-height: 1;
    transition: color .25s ease;
  }

  .card__tag {
    color: var(--c-muted);
    font-size: 13px;
    letter-spacing: .18em;
    text-transform: uppercase;
    max-width: 38ch;
    margin: 0;
    line-height: 1.55;
  }

  .card__problem,
  .card__solution {
    color: var(--c-muted);
    font-size: 12px;
    letter-spacing: .14em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.55;
    max-width: 42ch;
  }

  .card__problem b,
  .card__solution b {
    color: var(--c-text);
    font-weight: 700;
    letter-spacing: .22em;
    margin-right: 4px;
  }

  .card__solution b { color: var(--c-accent); }
  .card__solution   { color: var(--c-text); }

  .card__foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    font-size: 11px;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .card__arrow {
    font-size: 24px;
    color: var(--c-text);
    transition: transform .25s ease, color .25s ease;
    line-height: 1;
  }

  /* Card with bg image (Janus) */
  .card--img .card__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: .22;
    filter: saturate(.8);
  }

  .card--img .card__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card--img::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 15, 15, .6) 0%, rgba(15, 15, 15, .85) 100%);
    z-index: -1;
  }

  /* Coming-soon dimming */
  .card--soon .card__name { color: var(--c-muted); }
  .card--soon:hover .card__name { color: var(--c-text); }

  /* ── About ─────────────────────────────────────────────── */
  .about {
    padding: clamp(80px, 12vw, 160px) var(--gutter);
    border-top: 1px solid var(--c-border);
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(40px, 6vw, 100px);
  }

  .about__label {
    font-size: 11px;
    letter-spacing: .32em;
    text-transform: uppercase;
    color: var(--c-muted);
    display: flex;
    flex-direction: column;
  }

  .about__label b { color: var(--c-accent); font-weight: 700; }

  .about__label div:nth-child(2) { margin-top: 18px; }
  .about__label div:nth-child(3) { margin-top: 6px; color: var(--c-text); }

  .about__body p {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--c-text);
    max-width: 60ch;
    margin: 0 0 1.4em;
    line-height: 1.6;
  }

  .about__body p:last-child { margin-bottom: 0; }
  .about__body em { font-style: italic; color: var(--c-muted); }

  .about__sig {
    margin-top: 48px;
    display: flex;
    gap: 18px;
    align-items: center;
    font-size: 11px;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: var(--c-muted);
  }

  .about__sig-dash {
    width: 32px;
